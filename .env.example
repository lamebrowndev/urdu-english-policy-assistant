# Runtime configuration for the Urdu/English policy assistant.
# Every setting is read from the environment with the UPA_ prefix.
# Relative paths are resolved against the repository root (the nearest
# ancestor of the current directory containing pyproject.toml).

# Primary PostgreSQL connection string. Default:
# postgresql://upa:upa_dev_password@127.0.0.1:5433/upa
UPA_DATABASE_URL=postgresql://upa:upa_dev_password@127.0.0.1:5433/upa

# Test database. Its name must end in "_test"; integration tests refuse
# anything else. Default:
# postgresql://upa:upa_dev_password@127.0.0.1:5433/upa_test
UPA_TEST_DATABASE_URL=postgresql://upa:upa_dev_password@127.0.0.1:5433/upa_test

# Directory for downloaded source files and generated reports. Default: data
UPA_DATA_DIR=data

# Corpus manifest path. Default: corpus/manifest.yaml
UPA_MANIFEST_PATH=corpus/manifest.yaml

# Hugging Face tokenizer repository and immutable revision used for token
# counting. Do not change the revision without re-ingesting. Default:
# BAAI/bge-m3 at 9a0624b896d81da7492a910ffa53731274b6cf3d
UPA_TOKENIZER_REPO=BAAI/bge-m3
UPA_TOKENIZER_REVISION=9a0624b896d81da7492a910ffa53731274b6cf3d

# Chunking limits, measured with the bge-m3 tokenizer.
UPA_CHUNK_MAX_TOKENS=350
UPA_CHUNK_OVERLAP_TOKENS=50
UPA_CHUNK_MIN_TOKENS=60

# Per-page extraction quality thresholds. These are provisional; a human
# calibrates them on real PDFs.
UPA_QUALITY_MIN_CHARS=30
UPA_QUALITY_MAX_PUA_RATIO=0.01
UPA_QUALITY_MIN_SCRIPT_RATIO=0.60
UPA_QUALITY_MIN_LEXICON_UR=0.50
UPA_QUALITY_MIN_LEXICON_EN=0.60
UPA_QUALITY_REVERSED_MARGIN=0.15
UPA_QUALITY_MAX_FAILED_PAGE_RATIO=0.10
UPA_QUALITY_MAX_EMPTY_PAGE_RATIO=0.30

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default: INFO
UPA_LOG_LEVEL=INFO


# Retrieval models and device. Device "auto" picks MPS when available, else
# CPU. Model revisions are pinned for reproducible fingerprints.
UPA_EMBEDDING_REPO=BAAI/bge-m3
UPA_EMBEDDING_REVISION=9a0624b896d81da7492a910ffa53731274b6cf3d
UPA_RERANKER_REPO=BAAI/bge-reranker-v2-m3
UPA_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
UPA_DEVICE=auto
UPA_EMBED_BATCH_SIZE=16

# BM25 and hybrid retrieval parameters.
UPA_BM25_K1=1.2
UPA_BM25_B=0.75
UPA_RETRIEVE_CANDIDATES=50
UPA_RRF_K=60
UPA_RERANK_CANDIDATES=30
UPA_RETRIEVE_TOP_K=8
UPA_HNSW_EF_SEARCH=100


# Anthropic Claude API. The SDK resolves credentials itself from
# ANTHROPIC_API_KEY or an `ant auth login` profile; this file never stores one.
ANTHROPIC_API_KEY=
UPA_LLM_MODEL=claude-opus-5-5
UPA_LLM_EFFORT=medium
UPA_LLM_MAX_TOKENS=16000
UPA_LLM_TIMEOUT_SECONDS=120.0
UPA_LLM_FALLBACKS=default
UPA_ANSWER_MODE=hybrid_rerank
UPA_ABSTAIN_MIN_RERANK_SCORE=0.05
